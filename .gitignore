# Ignore everything by default (data, movies, images, plots, .mesc, venv, caches...)
*

# --- Keep only what's needed to read and run the project ---
!.gitignore
!README.md
!requirements.txt          # needed to recreate the environment

# Keep the Python scripts (any depth under code/)
!code/
!code/**/
!code/**/*.py

# Never keep compiled Python or macOS cruft, even under code/
__pycache__/
*.py[cod]
.DS_Store
